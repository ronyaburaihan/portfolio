---
const { base } = Astro.site ? { base: import.meta.env.BASE_URL } : { base: '' };
---

<header class="top" id="top">
    <div class="shell top-in">
        <a class="logo" href={`${base}/`} aria-label="Abu Raihan Rony — home"><b>AR</b> Abu Raihan Rony</a>
        <nav class="nav" id="nav" aria-label="Sections">
            <a href="#work">Work</a>
            <a href="#about">About</a>
            <a href="#experience">Experience</a>
            <a href="#skills">Expertise</a>
            <a href="#contact">Contact</a>
        </nav>
        <div class="top-cta">
            <button class="icon-btn menu-btn" id="menuBtn" aria-label="Open navigation" aria-controls="nav" aria-expanded="false">
                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <button class="icon-btn" id="motionBtn" aria-label="Pause animations" aria-pressed="false" title="Pause animations">
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path id="motionIcon" d="M9 5v14M15 5v14"/></svg>
            </button>
            <button class="icon-btn" id="themeBtn" aria-label="Switch colour theme" title="Switch theme">
                <svg class="icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                    <path id="themeIcon" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                </svg>
            </button>
            <a class="btn btn-primary btn-sm" href="mailto:ronyaburaihan@gmail.com">Get in touch</a>
        </div>
    </div>
    <div class="scroll-progress" aria-hidden="true"></div>
</header>
